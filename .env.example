# Local development only. Copy to .env; do not commit real credentials.
# Root docker-compose.yml already supplies these local defaults.
JWT_SECRET=local-dev-only-secret-key-with-at-least-32-bytes
JWT_EXPIRATION=86400000
S3_ACCESS_KEY=local-minio-access
S3_SECRET_KEY=local-minio-secret-change-before-deploy
S3_BUCKET_NAME=materials
# Optional for running backend directly instead of Compose:
DB_URL=jdbc:postgresql://localhost:5432/study_assistant_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Internal Compose endpoint; for direct bootRun use http://localhost:8333.
S3_ENDPOINT=http://seaweedfs:8333
# No new environment variables are needed for generation parameters.
# Optional port for the isolated PostgreSQL/HTTP smoke script (not the application).
GENERATION_TEST_PORT=18080
# OPENROUTER_API_KEY is not used by this branch; ML is not connected here.
