# Copy to .env and fill the four required credentials with independent random values. Never commit .env.
POSTGRES_DB=study_assistant_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=86400000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=materials
# Host ports can be changed when another stack is already running.
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
S3_PORT=8333
# Delay between durable generation queue checks; does not change frontend polling (2 seconds).
GENERATION_WORKER_DELAY_MS=1000
GENERATION_WORKERS=2
# ML: copy to .env for Docker Compose; real .env is ignored, never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_REASONING_ENABLED=false
ML_TOTAL_TIMEOUT_SECONDS=240
OPENROUTER_MAX_OUTPUT_TOKENS=12000
ML_MAX_INPUT_CHARS=60000
# Optional live test (explicit real request, disabled by default).
ML_LIVE_TEST=false
ML_LIVE_TYPE=single_choice
# Also supported: remaining (multiple_choice + true_false), all (three real requests).
ML_LIVE_COUNT=5
ML_LIVE_DIFFICULTY=medium

# Whole job: file retrieval + extraction + ML + result handling. 0 = max(300, ML timeout + 120).
GENERATION_JOB_TIMEOUT_SECONDS=0
# Server-side DB snapshot checks for WebSocket subscriptions (milliseconds).
GENERATION_WEBSOCKET_POLL_MS=2000
# Optional port for isolated generation-parameters HTTP smoke (not the application).
GENERATION_TEST_PORT=18080

# Materials API test runner only; deploy/compose/api-test.yml sets these automatically.
# Never point this suite at a developer or production database.
# API_BASE_URL=http://exam-ai-backend:8080
# API_TEST_DISPOSABLE=true
# API_TEST_VERSION=<tested-commit-sha>
