# Local development only. Copy to .env; never use these values on a deployed server.
POSTGRES_DB=study_assistant_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_SECRET=local-dev-only-secret-key-with-at-least-32-bytes
JWT_EXPIRATION=86400000
S3_ACCESS_KEY=local-minio-access
S3_SECRET_KEY=local-minio-secret-change-before-deploy
S3_BUCKET_NAME=materials
# Host ports can be changed when another stack is already running.
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
S3_PORT=8333
